#!/bin/sh
set -e

KC3="${KC3:-../kc3}"
KC3="$(cd "$KC3" && pwd)"
KC3_CONFIG_MK="$KC3/window/cairo/xcb/demo/config.mk"
CONFIG_MK=config.mk

if [ ! -f "$KC3_CONFIG_MK" ]; then
    echo "configure: $KC3_CONFIG_MK not found" >&2
    echo "configure: run ./configure in $KC3 first, or set KC3=" >&2
    exit 1
fi

kc3_var () {
    sed -n "s/^$1 = //p" "$KC3_CONFIG_MK" | head -n 1
}

CC="${CC:-$(kc3_var CC)}"
CAIRO_LIBS="$(pkg-config --libs cairo)"

LDFLAGS="-Wl,--export-dynamic"
for d in libkc3 window window/cairo window/cairo/xcb; do
    LDFLAGS="$LDFLAGS -L$KC3/$d -Wl,-rpath,$KC3/$d"
done

{
    echo "# config.mk generated by configure"
    echo "KC3 = $KC3"
    echo "CC = $CC"
    echo "CPPFLAGS = $(kc3_var CPPFLAGS) -DPROG=\"\\\"kmx_doom\\\"\" -I$KC3"
    echo "CFLAGS = $(kc3_var CFLAGS)"
    echo "LDFLAGS =$LDFLAGS"
    echo "LIBS = -lkc3_window_cairo_xcb -lkc3_window_cairo -lkc3_window -lkc3 $CAIRO_LIBS -lm"
} > "$CONFIG_MK"

echo "configure: KC3 = $KC3"
echo "configure: wrote $CONFIG_MK"

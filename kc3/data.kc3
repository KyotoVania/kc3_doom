    ("l") { :leak }
    ("r") { :race }
    ("d") { :dfree }
    ("B") { :boss }
    (other) { void }
  }

end

defmodule DoomLevel do

  defstruct [name: "",
             sub: "",
             floor: (U32) 0,
             ceil: (U32) 0,
             a: (F64) 0.0,
             fog: (F64) 0.0,
             thomas: [],
             outro: "",
             map: []]

end


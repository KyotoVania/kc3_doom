defmodule DoomTips do

  def all = ["Fact : `unquote (x)` avec l'espace, sinon c'est un appel.",
             "Fact : `! a && b` se lit `! (a && b)`.",
             "Fact : en kc3, void rend 404.",
             "Fact : List.filter garde le résultat, pas l'élément.",
             "Fact : clean_dump AVANT l'édition. Jamais après.",
             "Fact : pas d'ASan sur OpenBSD. MALLOC_OPTIONS=CDFGJU.",
             "Fact : tout est cow. N'enquête pas sur le refcount.",
             "Fact : env_fork partage err. Verrou récursif.",
             "Fact : les resets ? Le tunnel SSH. Encore.",
             "Fact : lire 0 octet n'est pas une erreur. Teste <= 0.",
             "Fact : commits kmx.io = une ligne, sans corps.",
             "Fact : un test RED avant chaque fix. Toujours."]

end

defmodule DoomItems do

  def get = fn {
    ("c") { {DoomTex.item_coffee, (F64) 0.35, (F64) 0.0} }
    ("a") { {DoomTex.item_ammo, (F64) 0.35, (F64) 0.0} }
    ("f") { {DoomTex.item_fact, (F64) 0.4, (F64) 0.25} }
    ("g") { {DoomTex.item_gdb, (F64) 0.5, (F64) 0.0} }
    ("z") { {DoomTex.item_asan, (F64) 0.5, (F64) 0.0} }
    ("v") { {DoomTex.item_armor, (F64) 0.42, (F64) 0.0} }
    (other) { void }
  }

end

defmodule DoomMobChars do


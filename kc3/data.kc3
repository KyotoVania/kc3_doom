defmodule DoomTex do

  def wall_1 = (U32) 0

  def wall_2 = (U32) 1

  def wall_3 = (U32) 2

  def wall_4 = (U32) 3

  def wall_5 = (U32) 4

  def wall_6 = (U32) 5

  def wall_d = (U32) 6

  def wall_x = (U32) 7

  def floor_tile = (U32) 8

  def floor_grate = (U32) 9

  def floor_carpet = (U32) 10

  def floor_panel = (U32) 11

  def floor_dark = (U32) 12

  def segv_walk_0 = (U32) 13

  def segv_walk_1 = (U32) 14

  def segv_atk = (U32) 15

  def segv_dead = (U32) 16

  def leak_walk_0 = (U32) 17

  def leak_walk_1 = (U32) 18

  def leak_atk = (U32) 19

  def leak_dead = (U32) 20

  def race_walk_0 = (U32) 21

  def race_walk_1 = (U32) 22

  def race_atk = (U32) 23

  def race_dead = (U32) 24

  def dfree_walk_0 = (U32) 25

  def dfree_walk_1 = (U32) 26

  def dfree_atk = (U32) 27

  def dfree_dead = (U32) 28

  def free1_walk_0 = (U32) 29

  def free1_walk_1 = (U32) 30

  def free1_atk = (U32) 31

  def free1_dead = (U32) 32

  def boss_walk_0 = (U32) 33

  def boss_walk_1 = (U32) 34

  def boss_atk = (U32) 35

  def boss_dead = (U32) 36

  def thomas_0 = (U32) 37

  def thomas_1 = (U32) 38

  def item_coffee = (U32) 39

  def item_ammo = (U32) 40

  def item_fact = (U32) 41

  def item_gdb = (U32) 42

  def item_asan = (U32) 43

  def item_armor = (U32) 44

  def proj = (U32) 45

  def bproj = (U32) 46

  def count = (U32) 47

  def floor = fn {
    (:tile) { DoomTex.floor_tile }
    (:grate) { DoomTex.floor_grate }
    (:carpet) { DoomTex.floor_carpet }
    (:panel) { DoomTex.floor_panel }
    (:dark) { DoomTex.floor_dark }
  }

end

defmodule DoomMobTex do

  def walk_0 = fn {
    (:segv) { DoomTex.segv_walk_0 }
    (:leak) { DoomTex.leak_walk_0 }
    (:race) { DoomTex.race_walk_0 }
    (:dfree) { DoomTex.dfree_walk_0 }
    (:free1) { DoomTex.free1_walk_0 }
    (:boss) { DoomTex.boss_walk_0 }
  }

  def walk = fn (type, frame) {
    (U32) (DoomMobTex.walk_0(type) + (U32) frame)
  }

  def atk = fn {
    (:segv) { DoomTex.segv_atk }
    (:leak) { DoomTex.leak_atk }
    (:race) { DoomTex.race_atk }
    (:dfree) { DoomTex.dfree_atk }
    (:free1) { DoomTex.free1_atk }
    (:boss) { DoomTex.boss_atk }
  }

  def dead = fn {
    (:segv) { DoomTex.segv_dead }
    (:leak) { DoomTex.leak_dead }
    (:race) { DoomTex.race_dead }
    (:dfree) { DoomTex.dfree_dead }
    (:free1) { DoomTex.free1_dead }
    (:boss) { DoomTex.boss_dead }
  }

end

defmodule DoomMobType do

  defstruct [hp: (F64) 0.0,
             sp: (F64) 0.0,
             sc: (F64) 0.0,
             ranged: false,
             melee: false,
             rate: (F64) 0.0,
             dmg: (F64) 0.0,
             keep: (F64) 0.8,
             flick: false,
             split: false,
             burst: (U8) 1,
             no_pain: false,
             msg: []]

end

defmodule DoomTypes do

  def get = fn {
    (:segv) {
      %DoomMobType{hp: (F64) 30.0,
                   sp: (F64) 1.3,
                   sc: (F64) 0.8,
                   ranged: true,
                   rate: (F64) 1.8,
                   dmg: (F64) 9.0,
                   keep: (F64) 3.5,
                   msg: ["SIGSEGV corrigé. NULL-check ajouté.",
                         "Segfault fixé. Test RED puis GREEN."]}
    }
    (:leak) {
      %DoomMobType{hp: (F64) 70.0,
                   sp: (F64) 0.8,
                   sc: (F64) 0.85,
                   melee: true,
                   rate: (F64) 1.0,
                   dmg: (F64) 14.0,
                   msg: ["Leak fixé. LSan au vert.",
                         "Fuite colmatée. heaptrack content."]}
    }
    (:race) {
      %DoomMobType{hp: (F64) 25.0,
                   sp: (F64) 2.8,
                   sc: (F64) 0.85,
                   melee: true,
                   rate: (F64) 0.6,
                   dmg: (F64) 7.0,
                   flick: true,
                   msg: ["Race éliminée. Verrou récursif posé.",
                         "Data race : rwlock ajouté."]}
    }
    (:dfree) {
      %DoomMobType{hp: (F64) 45.0,
                   sp: (F64) 1.1,
                   sc: (F64) 0.8,
                   ranged: true,
                   rate: (F64) 2.2,
                   dmg: (F64) 11.0,
                   keep: (F64) 4.0,
                   split: true,
                   msg: ["Premier free()... attention au second."]}
    }
    (:free1) {
      %DoomMobType{hp: (F64) 14.0,
                   sp: (F64) 2.0,
                   sc: (F64) 0.5,
                   melee: true,
                   rate: (F64) 0.8,
                   dmg: (F64) 6.0,
                   msg: ["ptr = NULL après free. Propre."]}
    }
    (:boss) {
      %DoomMobType{hp: (F64) 900.0,
                   sp: (F64) 0.9,
                   sc: (F64) 1.8,
                   ranged: true,
                   rate: (F64) 0.9,
                   dmg: (F64) 16.0,
                   keep: (F64) 5.0,
                   burst: (U8) 5,
                   no_pain: true,
                   msg: ["env->err : verrou posé. La prod tient !"]}
    }
  }

end

